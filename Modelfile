FROM ./outputs/foodpharmer-q4_k_m.gguf

# Replicates the exact Llama 3.2 Instruct chat template used during fine-tuning.
# Training data had NO separate system message — the instruction was embedded
# in the user turn. {{ .Prompt }} receives the full user message from the app.
TEMPLATE """<|begin_of_text|><|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|><|start_header_id|>assistant<|end_header_id|>

"""

# Low temperature for deterministic JSON output (matches training intent)
PARAMETER temperature 0.1
# Output is a short JSON blob — 150 tokens is plenty for score+risk+flags+summary
PARAMETER num_predict 150
# Stop generation at end-of-turn token
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
